# Password condivisa per accesso MVP. Cambiala prima di esporre l'app.
CRM_PASSWORD=imposta-una-password-lunga
# Segreto casuale di almeno 32 caratteri per firmare la sessione.
SESSION_SECRET=imposta-un-segreto-casuale-di-almeno-32-caratteri
# Database PostgreSQL/Neon (richiesto su Vercel; opzionale in locale).
# DATABASE_URL=postgresql://...
# In locale, senza database, i dati restano nel file data/crm.json.
# CRM_DATA_DIR=/percorso/locale/persistente
